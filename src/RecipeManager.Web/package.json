{
  "name": "recipe-manager-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:contracts": "sh ../../scripts/check-contracts.sh",
    "test:e2e": "npm --prefix ../../tests/e2e test",
    "lint": "eslint src",
    "format:check": "prettier --check src angular.json tsconfig*.json eslint.config.js proxy.conf.cjs"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@microsoft/signalr": "10.0.11",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=12.0.0 <13"
  },
  "type": "module"
}
